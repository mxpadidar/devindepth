---
import "../styles/global.css";
import { Font } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <Font cssVariable="--astro-font-ubuntu-mono" />
    <Font cssVariable="--astro-font-alkatra" />

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <title>DevInDepth</title>
  </head>
  <body class="font-ubuntu-mono bg-zinc-900 text-zinc-300 leading-6">
    <Header />
    <main class="min-h-screen max-w-3xl mx-auto px-5">
      <slot />
    </main>

    <Footer />
  </body>
</html>
